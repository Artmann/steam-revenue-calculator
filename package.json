    "@testing-library/dom": "^9.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.0.35",
    "@types/react-dom": "^18.0.11",
    "eslint": "^8.38.0",
    "jsdom": "^30.1.2",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5.0.4",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^5.0.4"
