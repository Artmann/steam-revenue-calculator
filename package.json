{
  "name": "steam-revenue-calculator",
  "description": "Estimate how much any Steam game has earned using the Boxleiter method, with a full breakdown of Steam's cut, VAT, refunds, regional pricing, and discounts.",
  "keywords": [
    "steam",
    "steam-api",
    "revenue-calculator",
    "boxleiter",
    "indie-games",
    "game-development",
    "game-revenue",
    "sales-estimation",
    "react-router",
    "mongodb",
    "typescript"
  ],
  "homepage": "https://steam-revenue-calculator.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Artmann/steam-revenue-calculator.git"
  },
  "packageManager": "pnpm@10.33.0",
  "private": true,
  "license": "MIT",
  "sideEffects": false,
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "start": "node build/server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "react-router typegen && tsc",
    "seed:local": "tsx scripts/seed-local.ts",
    "parity:capture": "tsx scripts/parity.ts capture",
    "parity:compare": "tsx scripts/parity.ts compare",
    "workflow:web": "workflow web"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@react-router/node": "^7.18.4",
    "@vercel/analytics": "^1.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "esix": "^5.7.0",
    "isbot": "^5.2.2",
    "mongodb": "^6.21.0",
    "nitro": "3.0.260903-beta",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router": "^7.18.4",
    "slugify": "^1.6.6",
    "tailwind-merge": "^2.4.0",
    "tailwindcss-animate": "^1.0.7",
    "tqdm": "^2.0.3",
    "workflow": "^5.2.0"
  },
  "devDependencies": {
    "@mdx-js/rollup": "^3.1.1",
    "@react-router/dev": "^7.18.4",
    "@react-router/fs-routes": "^7.18.4",
